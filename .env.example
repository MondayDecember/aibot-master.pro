BOT_TOKEN=your_telegram_bot_token_here

# NOTE: If Ollama is running on your host machine and this bot is running in Docker,
# you CANNOT use 'localhost' here, because 'localhost' refers to the bot's container itself.
# Use 'host.docker.internal' (works on Windows/Mac/Linux thanks to extra_hosts in compose).
# If you run Ollama in docker via the compose profile (COMPOSE_PROFILES=ollama below),
# set this to http://ollama:11434/v1 instead.
OLLAMA_API_BASE=http://host.docker.internal:11434/v1

# Uncomment to run Ollama inside docker instead of on the host
# (also change OLLAMA_API_BASE above to http://ollama:11434/v1):
# COMPOSE_PROFILES=ollama
OLLAMA_API_KEY=ollama

# Pointing to the Redis service defined in docker-compose.yml
REDIS_URL=redis://redis:6379/0

TEXT_MODEL=llama3
VISION_MODEL=llama3.2-vision
WHISPER_MODEL=base

# Automatic web search: the bot asks the LLM (an extra request!) whether each
# message needs fresh data from the web. Set to false to answer ~2x faster;
# the explicit /web command keeps working either way.
AUTO_WEB_SEARCH=true

# Stream replies token by token (ChatGPT-style progressive message edits).
STREAM_RESPONSES=true

# Language of the bot's interface messages: ru or en. Model replies always
# follow the user's language regardless of this setting.
BOT_LANGUAGE=ru

# Comma-separated telegram user IDs allowed to use the bot. Empty = open to
# everyone. Rejected users are shown their ID so you can add them here.
# ALLOWED_USER_IDS=123456789,987654321

# Who can use /stats. Defaults to the first ID in ALLOWED_USER_IDS.
# ADMIN_USER_ID=123456789

# Anti-spam: how many LLM requests one user may queue per minute (0 = off).
RATE_LIMIT_PER_MINUTE=10

# Group chatter: percent chance (0-100) that the bot spontaneously joins the
# group conversation like a regular member. 0 = only reacts to @mentions and
# replies. The cooldown (seconds) caps it at one remark per chat per interval.
GROUP_CHATTINESS=0
GROUP_CHATTER_COOLDOWN=300

# How many characters of an uploaded document (PDF/text) are passed to the
# LLM. Local models have small context windows, keep this modest.
DOC_MAX_CHARS=12000

# How many past messages the LLM sees as conversation memory. Full history
# is stored in SQLite forever - this only limits the model's context.
HISTORY_LIMIT=10

# Snapshot the database to data/backups/ every N hours (0 = disable),
# keeping the newest BACKUP_KEEP files.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Long-term memory: every SUMMARIZE_EVERY messages the bot folds older
# conversation into a compact summary it always keeps in mind.
LONG_TERM_MEMORY=true
SUMMARIZE_EVERY=20
# SUMMARY_MAX_CHARS=1500

# Auto-updates: uncomment to run the bot from the prebuilt ghcr.io image and
# let Watchtower update it automatically (see docker-compose.autoupdate.yml).
# On Windows use ';' instead of ':' as the separator.
# COMPOSE_FILE=docker-compose.yml:docker-compose.autoupdate.yml
OPENAI_API_KEY=not_needed_for_ollama

# Optional: models selectable in Telegram via /model (comma-separated key=model pairs).
# Photo analysis always uses VISION_MODEL regardless of this setting.
# MODEL_CHOICES=default=qwen2.5vl:7b,coder=qwen3-coder:30b,uncensored=hf.co/OBLITERATUS/Gemma-4-12B-OBLITERATED:Q4_K_M
