BOT_TOKEN=your_telegram_bot_token_here

# Any OpenAI-compatible local server works here - the name is historical.
# Confirmed working: Ollama and LM Studio (Settings -> Developer -> enable
# "Local Server"; LM Studio defaults to port 1234, not 11434 - and its
# server must be running with a model already loaded).
#
# NOTE: If the server is running on your host machine and this bot is running
# in Docker, you CANNOT use 'localhost' here, because 'localhost' refers to
# the bot's container itself. Use 'host.docker.internal' (works on
# Windows/Mac/Linux thanks to extra_hosts in compose).
# If you run Ollama in docker via the compose profile (COMPOSE_PROFILES=ollama
# below), set this to http://ollama:11434/v1 instead.
OLLAMA_API_BASE=http://host.docker.internal:11434/v1

# Uncomment to run Ollama inside docker instead of on the host
# (also change OLLAMA_API_BASE above to http://ollama:11434/v1):
# COMPOSE_PROFILES=ollama
# Ignored by both Ollama and LM Studio - neither checks it by default - but
# the OpenAI client library requires some non-empty value.
OLLAMA_API_KEY=ollama

# Pointing to the Redis service defined in docker-compose.yml
REDIS_URL=redis://redis:6379/0

TEXT_MODEL=llama3
VISION_MODEL=llama3.2-vision
WHISPER_MODEL=base

# OCR photos with Tesseract (CPU) before the vision model - reads text off
# screenshots/documents reliably. OCR_LANGUAGES is a Tesseract lang string.
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng

# Context window (tokens) sent to the model. Ollama's default is a small
# 2048/4096 that quietly forgets older messages - raise this to actually
# remember more (e.g. 8192). 0 = use the model's own default. Costs RAM/VRAM.
MODEL_NUM_CTX=0

# Show a "🔢 tokens" footer under each reply (prompt+completion=total).
SHOW_TOKENS=false

# Log every LLM reply (time, user, model, tokens) for the /usage command.
USAGE_STATS=true
# Delete usage-log rows older than N days (0 = keep forever).
USAGE_RETENTION_DAYS=90

# Voice replies: reply with a synthesized voice note (in addition to text)
# when the incoming message was itself voice. Local neural TTS (Piper),
# CPU-only, no GPU needed. Voice auto-picked from BOT_LANGUAGE if unset -
# override with any name from https://github.com/rhasspy/piper/blob/master/VOICES.md
VOICE_REPLIES=true
# TTS_VOICE=ru_RU-dmitri-medium
TTS_MAX_CHARS=1000

# Image generation (/imagine): talks to the separate service in imagegen/,
# which you start yourself - it runs natively on the host, not in Docker
# (see imagegen/README.md for why). Leave false until you've run it.
IMAGEGEN_ENABLED=false
# IMAGEGEN_API_BASE=http://host.docker.internal:7861
# Must match IMAGEGEN_API_KEY in imagegen/.env - protects the GPU service
# from anyone else on the network. Empty = no auth.
# IMAGEGEN_API_KEY=

# Automatic web search: the bot asks the LLM (an extra request!) whether each
# message needs fresh data from the web. Set to false to answer ~2x faster;
# the explicit /web command keeps working either way.
AUTO_WEB_SEARCH=true

# Deep web search: open the top N result pages and read their text instead of
# answering from short search snippets. 0 = snippets only. Bigger values need
# a model with a larger context window.
WEB_FETCH_PAGES=2
WEB_PAGE_MAX_CHARS=2000

# React with 👀 to a message the moment the bot picks it up ("seen").
REACT_ON_SEEN=true

# Stream replies token by token (ChatGPT-style progressive message edits).
STREAM_RESPONSES=true
# Seconds between streaming edits (lower = smoother, but telegram throttles
# edits at ~1/sec per chat - going below 1.0 risks flood-wait freezes).
STREAM_EDIT_INTERVAL=1.0

# Language of the bot's interface messages: ru or en. Model replies always
# follow the user's language regardless of this setting.
BOT_LANGUAGE=ru

# Comma-separated telegram user IDs allowed to use the bot. Empty = open to
# everyone. Rejected users are shown their ID so you can add them here.
# ALLOWED_USER_IDS=123456789,987654321

# Who can use /stats. Defaults to the first ID in ALLOWED_USER_IDS.
# ADMIN_USER_ID=123456789

# Anti-spam: how many LLM requests one user may queue per minute (0 = off).
RATE_LIMIT_PER_MINUTE=10

# Group chatter: percent chance (0-100) that the bot spontaneously joins the
# group conversation like a regular member. 0 = only reacts to @mentions and
# replies. The cooldown (seconds) caps it at one remark per chat per interval.
GROUP_CHATTINESS=0
GROUP_CHATTER_COOLDOWN=300

# How many characters of an uploaded document (PDF/text) are passed to the
# LLM. Local models have small context windows, keep this modest.
DOC_MAX_CHARS=12000

# How many past messages the LLM sees as conversation memory. Full history
# is stored in SQLite forever - this only limits the model's context.
HISTORY_LIMIT=10

# Snapshot the database to data/backups/ every N hours (0 = disable),
# keeping the newest BACKUP_KEEP files.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Long-term memory: every SUMMARIZE_EVERY messages the bot folds older
# conversation into a compact summary it always keeps in mind.
LONG_TERM_MEMORY=true
SUMMARIZE_EVERY=20
# SUMMARY_MAX_CHARS=1500

# Model for memory summaries and reminder parsing. Empty = the main
# TEXT_MODEL. A small model (e.g. llama3.2:3b) is much faster for these
# background jobs and avoids swapping the big model out of RAM.
SUMMARY_MODEL=

# Timezone for reminders and the bot's sense of "now" (IANA name).
TIMEZONE=Europe/Moscow

# Auto-updates: uncomment to run the bot from the prebuilt ghcr.io image and
# let Watchtower update it automatically (see docker-compose.autoupdate.yml).
# On Windows use ';' instead of ':' as the separator.
# COMPOSE_FILE=docker-compose.yml:docker-compose.autoupdate.yml
OPENAI_API_KEY=not_needed_for_ollama

# Optional: models selectable in Telegram via /model (comma-separated key=model pairs).
# Photo analysis always uses VISION_MODEL regardless of this setting.
# MODEL_CHOICES=default=qwen2.5vl:7b,coder=qwen3-coder:30b,uncensored=hf.co/OBLITERATUS/Gemma-4-12B-OBLITERATED:Q4_K_M
