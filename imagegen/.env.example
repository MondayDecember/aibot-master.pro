# Copy to .env and adjust. See README.md for the full list of options.

# stabilityai/sd-turbo (default, ~5GB downloaded, fast, fits comfortably in
# 16GB via DirectML) or stabilityai/sdxl-turbo (sharper/more detailed, but
# ~10GB+ just sitting loaded in fp32 - OOM'd on a 16GB AMD card via
# DirectML even after enable_vae_slicing()/enable_attention_slicing(); its
# fp16 path also needs a special VAE to avoid NaN output - untested here)
IMAGEGEN_MODEL=stabilityai/sd-turbo
IMAGEGEN_STEPS=1
IMAGEGEN_GUIDANCE_SCALE=0.0
IMAGEGEN_MAX_PROMPT_CHARS=500

# Shared secret with the bot. The service binds 0.0.0.0 (host.docker.internal
# needs it), so set a random string here AND the same value in the bot's .env
# as IMAGEGEN_API_KEY - otherwise anyone on your network can burn the GPU.
# Empty = no auth (only safe on a fully isolated host).
IMAGEGEN_API_KEY=
